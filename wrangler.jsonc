{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-cms",
  "compatibility_date": "2026-08-14",
  "pages_build_output_dir": "dist/public",
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "atelier-cms",
      "database_id": "d79481e3-a539-4c79-9cdb-3b8f4ae3cb65"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CMS_MEDIA",
      "bucket_name": "atelier-cms-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMS_CACHE",
      "id": "0ba1110d7669485ea698bb60dc538be8"
    }
  ],
  "vars": {
    "CMS_ORIGIN": "https://atelier-cms.pages.dev",
    "CMS_TOKEN_TTL_SECONDS": "2592000"
  }
}
