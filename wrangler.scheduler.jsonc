{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-cms-scheduler",
  "main": "workers/scheduler.ts",
  "compatibility_date": "2026-08-14",
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "atelier-cms",
      "database_id": "d79481e3-a539-4c79-9cdb-3b8f4ae3cb65"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
